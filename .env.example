# Application et base PostgreSQL (obligatoires en mode connecté)
DATABASE_URL=
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=

# Paiement Stripe (obligatoires pour activer le paiement réel)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Images Cloudinary (obligatoires pour les téléversements en production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Création optionnelle d'un administrateur persistant pendant le seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=

# Authentification de démonstration, uniquement en développement
DEMO_AUTH_ENABLED=
DEMO_REGISTRATION_ENABLED=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_NAME=
DEMO_ADMIN_PASSWORD_HASH=
DEMO_USER_EMAIL=
DEMO_USER_NAME=
DEMO_USER_PASSWORD_HASH=

# Durée optionnelle d'une session, en secondes (entre 300 et 604800)
AUTH_SESSION_MAX_AGE_SECONDS=

# Stockage JSON durable pour la démo locale (jamais recommandé sur Vercel)
DEMO_PRODUCT_STORE_ENABLED=
# Nom de fichier facultatif, toujours borné au dossier privé .data/
DEMO_PRODUCT_STORE_PATH=
